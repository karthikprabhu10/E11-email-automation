        "jsCode": "const c = $('Loop Over Items').item.json;\nconst q = v => '\"' + String(v ?? '').replace(/\"/g, '\"\"') + '\"';\nconst line = [c.email, c.first_name, c.company, new Date().toISOString()].map(q).join(',') + '\\n';\nreturn {\n  json: { email: c.email, first_name: c.first_name, company: c.company },\n  binary: { data: await this.helpers.prepareBinaryData(Buffer.from(line, 'utf8'), 'sent_row.csv', 'text/csv') },\n};\n"
