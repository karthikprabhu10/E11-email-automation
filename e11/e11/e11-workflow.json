      "id": "744fb0ba-217a-4828-8b9d-6d714e794837",
      "name": "Parse Sent Log",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1,
      "position": [
        1780,
        80
      ],
      "alwaysOutputData": true,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// Everything the UI sends arrives in the webhook body.\nconst req = $('E11 API').first().json.body || {};\nconst contacts = Array.isArray(req.contacts) ? req.contacts : [];\nconst subjectTpl = String(req.subject || '').trim();\nconst bodyTpl = String(req.message || '');\nif (!subjectTpl || !bodyTpl.trim()) return [];\n\nconst clamp = (n, lo, hi) => Math.min(hi, Math.max(lo, n));\nconst cap = clamp(parseInt(req.max_per_run, 10) || 40, 1, 200);\nconst dmin = clamp(parseInt(req.delay_min, 10) || 20, 5, 60);\nconst dmax = clamp(parseInt(req.delay_max, 10) || 45, dmin, 60);\n\n// emails already sent (from sent_log.csv)\nconst sent = new Set(\n  $('Parse Sent Log').all()\n    .map(i => String(i.json.email || '').trim().toLowerCase())\n    .filter(Boolean)\n);\n\n// company = text between @ and the first dot: akshay@flipkart.com -> Flipkart\nconst GENERIC = new Set(['gmail','yahoo','outlook','hotmail','rediffmail','icloud','proton','protonmail']);\nfunction companyFromEmail(email) {\n  const label = email.split('@')[1].split('.')[0];\n  if (GENERIC.has(label)) return 'your company';\n  return label.charAt(0).toUpperCase() + label.slice(1);\n}\nconst fill = (tpl, v) => tpl.replace(/\\{\\s*(first_name|last_name|email|company)\\s*\\}/g, (_, k) => v[k]);\n\nconst seen = new Set();\nconst out = [];\nfor (const c of contacts) {\n  const email = String(c.email || '').trim().toLowerCase();\n  if (!/^[^@\\s]+@[^@\\s]+\\.[a-z]{2,}$/.test(email)) continue;   // skip invalid / empty\n  if (sent.has(email) || seen.has(email)) continue;            // skip already sent + duplicates\n  seen.add(email);\n  const v = {\n    first_name: String(c.first_name || '').trim() || 'there',\n    last_name: String(c.last_name || '').trim(),\n    email,\n    company: companyFromEmail(email),\n  };\n  out.push({ json: { ...v, subject: fill(subjectTpl, v), message: fill(bodyTpl, v), delay_min: dmin, delay_max: dmax } });\n}\nreturn out.slice(0, cap);   // daily cap\n"
      },
